# Bu dosyayı .env olarak kopyalayıp gerçek değerleri yaz.
# .env dosyası .gitignore'da — ASLA commit'leme.

FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=degistir-bunu-uzun-rastgele-bir-string-yap

# SQLite (geliştirme) veya PostgreSQL (üretim)
DATABASE_URL=sqlite:///ikincielmarket.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/ikincielmarket

# E-posta (şifre sıfırlama için — Gmail App Password örneği)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@ikincielmarket.local

# Admin kullanıcı (ilk seed için)
ADMIN_EMAIL=admin@ikincielmarket.local
ADMIN_PASSWORD=admin1234

# Yükleme limitleri
MAX_CONTENT_LENGTH=5242880
